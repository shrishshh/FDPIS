# Deployment artifacts (deploy/build_space.py). The slim serving set is
# COMMITTED so Render can build from the repo; exactly these files are
# re-included. The full data/ and results/ stay ignored.
!deploy/backend/artifacts/
!deploy/backend/artifacts/results/
!deploy/backend/artifacts/results/layer4/
!deploy/backend/artifacts/results/layer4/config.json
!deploy/backend/artifacts/results/candidates/
!deploy/backend/artifacts/results/candidates/weather_b/
!deploy/backend/artifacts/results/candidates/weather_b/comparison.csv
!deploy/backend/artifacts/results/layer5/
!deploy/backend/artifacts/results/layer5/actionable_metrics.csv
!deploy/backend/artifacts/results/layer5/naive_comparison.csv
!deploy/backend/artifacts/results/layer5/lead_time_summary.csv
!deploy/backend/artifacts/results/layer5/backtest_meta.csv
!deploy/backend/artifacts/results/layer5/three_band.csv
!deploy/backend/artifacts/results/layer5/recall_precision_sets.csv
!deploy/backend/artifacts/slim/
!deploy/backend/artifacts/slim/flights.parquet
!deploy/backend/artifacts/slim/lk_origin_hour.parquet
!deploy/backend/artifacts/slim/lk_carrier_hour.parquet
!deploy/backend/artifacts/slim/lk_route.parquet
!deploy/backend/artifacts/slim/meta.json
# Test-image-only copies of full results files: never committed.
deploy/backend/testdata/

# Frontend config that the *.json rule above would otherwise hide. Without these
# Vercel finds no Next.js dependency ("NEXT_NO_VERSION").
!fdpis-web/package.json
!fdpis-web/package-lock.json
!fdpis-web/tsconfig.json
