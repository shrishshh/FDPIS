# FDPIS API environment variables. Names only: set real values in the host's
# dashboard (Render), never in a committed file. Without the WhatsApp values the
# API behaves exactly as before: every notification is simulated.

# CORS: comma-separated origins allowed to call the API.
ALLOWED_ORIGINS=

# Live WhatsApp demo channel (api/notifier.py). Live only when NOTIFY_MODE=whatsapp
# AND the account SID, auth token and NOTIFY_TO are all set.
NOTIFY_MODE=simulated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Defaults to whatsapp:+17372508034 (the Twilio WhatsApp sandbox sender) when unset.
TWILIO_WHATSAPP_FROM=
# The single demo recipient, e.g. whatsapp:+<country code><number>.
NOTIFY_TO=
# Live send attempts per server process before falling back to simulated (default 20).
NOTIFY_MAX_LIVE=
